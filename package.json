{
  "name": "travel-explorer",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack travel discovery and enquiry website.",
  "scripts": {
    "start": "node server.js",
    "server": "cross-env PORT=3001 node server.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
